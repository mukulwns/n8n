#!/usr/bin/env node

const path = require('path');
const dotenv = require('dotenv');

// ✅ Load .env file from the correct location only once
dotenv.config({ path: path.resolve(__dirname, '../.env') });

// ✅ Print relevant environment variables for debugging
console.log('Environment:', {
	DB_TYPE: process.env.DB_TYPE,
	DB_POSTGRESDB_DATABASE: process.env.DB_POSTGRESDB_DATABASE,
	DB_POSTGRESDB_SSL_ENABLED: process.env.DB_POSTGRESDB_SSL_ENABLED,
	N8N_RUNNERS_ENABLED: process.env.N8N_RUNNERS_ENABLED,
});

// ✅ Ensure the config directory is set correctly
process.env.NODE_CONFIG_DIR = process.env.NODE_CONFIG_DIR || path.join(__dirname, 'config');

// ✅ Handle version flag (`-v`, `--version`)
const versionFlags = ['-v', '-V', '--version'];
if (versionFlags.includes(process.argv.slice(-1)[0])) {
	console.log(require('../package.json').version);
	process.exit(0);
}

// ✅ Validate Node.js version
const satisfies = require('semver/functions/satisfies');
const nodeVersion = process.versions.node;
const {
	engines: { node: supportedNodeVersions },
} = require('../package.json');

if (!satisfies(nodeVersion, supportedNodeVersions)) {
	console.error(`
Your Node.js version ${nodeVersion} is not supported by n8n.
Please use a version that satisfies: ${supportedNodeVersions}
`);
	process.exit(1);
}

// ✅ Disable custom inspection globally
const { inspect } = require('util');
inspect.defaultOptions.customInspect = false;

// ✅ Enable source maps and metadata
require('source-map-support').install();
require('reflect-metadata');

// ✅ Load config early
require('../dist/config');

// ✅ Force IPv4 if configured
if (process.env.NODEJS_PREFER_IPV4 === 'true') {
	require('dns').setDefaultResultOrder('ipv4first');
}

// ✅ Fix for Node.js 20 “Happy Eyeballs” DNS bug
require('net').setDefaultAutoSelectFamily?.(false);

// ✅ Boot n8n
(async () => {
	const { Container } = await import('@n8n/di');
	const { CommandRegistry } = await import('../dist/command-registry.js');
	await Container.get(CommandRegistry).execute();
})();
